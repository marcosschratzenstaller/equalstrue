{
	"scripts": {
		"build": "wp-scripts build --blocks-manifest --source-path=blocks-src --output-path=blocks --webpack-copy-php",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"generate-hash": "node build/generate-hash.mjs",
		"icons": "npm-run-all icons-main --aggregate-output --parallel icons-font icons-block",
		"icons-main": "node build/build-svgs.mjs",
		"icons-font": "npm-run-all icons-font-*",
		"icons-font-main": "fantasticon",
		"icons-block": "npm-run-all icons-block-*",
		"icons-block-files": "node build/convert-svg.js --capitalize=equalstrue:EqualsTrue",
		"icons-block-index": "node build/generate-index.js --first=equalstrue",
		"icons-block-variations": "node build/generate-variations.js --capitalize=equalstrue:'Equals True'",
		"start": "wp-scripts start --blocks-manifest --source-path=blocks-src --output-path=blocks --webpack-copy-php"
	},
	"devDependencies": {
		"@twbs/fantasticon": "^3.1.0",
		"@wordpress/scripts": "^30.14.1",
		"npm-run-all2": "^7.0.2",
		"svgo": "^3.3.2"
	}
}
