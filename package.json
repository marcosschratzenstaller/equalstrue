{
	"scripts": {
		"build": "wp-scripts build --blocks-manifest --source-path=blocks-src --output-path=blocks --webpack-copy-php",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"generate-hash": "node build/generate-hash.mjs",
		"icons": "npm-run-all icons-main --aggregate-output --parallel icons-block",
		"icons-main": "node build/build-svgs.mjs",
		"icons-block": "npm-run-all icons-block-*",
		"icons-block-files": "node build/convert-svg.js",
		"icons-block-index": "node build/generate-index.js",
		"icons-block-variations": "node build/generate-variations.js",
		"start": "wp-scripts start --blocks-manifest --source-path=blocks-src --output-path=blocks --webpack-copy-php"
	},
	"dependencies": {
		"@wordpress/block-editor": "latest",
		"@wordpress/blocks": "latest",
		"@wordpress/i18n": "latest"
	},
	"devDependencies": {
		"@twbs/fantasticon": "^3.1.0",
		"@wordpress/scripts": "^31.6.0",
		"clsx": "^2.1.1",
		"npm-run-all2": "^8.0.4",
		"svgo": "^4.0.1"
	}
}
