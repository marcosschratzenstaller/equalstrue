{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "equalstrue/icon",
	"version": "1.0.0",
	"title": "Icon",
	"category": "design",
	"example": {},
	"attributes": {},
	"supports": {
		"html": true,
		"color": {
			"text": true,
			"background": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"typography": {
			"fontSize": true
		},
		"__experimentalBorder": {
			"radius": true,
			"__experimentalDefaultControls": {
				"radius": true
			}
		}
	},
	"allowedBlocks": [ "equalstrue/icon-path" ],
	"textdomain": "equalstrue",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
