{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "equalstrue/newsletter-button",
	"title": "Button",
	"version": "1.0.0",
	"category": "widgets",
	"example": {},
	"attributes": {
		"text": {
			"type": "rich-text",
			"source": "rich-text",
			"selector": "button",
			"role": "content"
		}
	},
	"supports": {
		"html": false,
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"style": true,
				"width": true
			}
		}
	},
	"textdomain": "equalstrue",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
